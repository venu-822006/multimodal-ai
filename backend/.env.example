# FloodSight AI backend configuration.
# Copy to backend/.env and edit. Never commit a filled-in .env file.

# ---------------------------------------------------------------- application
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------- database
# Docker Compose overrides this to point at the postgres service.
DATABASE_URL=postgresql+psycopg://floodsight:floodsight@127.0.0.1:5432/floodsight

# ---------------------------------------------------------------- CORS
# Comma separated. Use explicit origins; wildcards are rejected in production.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173
CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------- authentication
# Server-side sessions. The browser stores an opaque session token in an HttpOnly
# cookie; only its SHA-256 hash is stored in PostgreSQL. See backend/README.md.
AUTH_SESSION_COOKIE_NAME=floodsight_session
AUTH_SESSION_TTL_SECONDS=604800
# Local HTTP development keeps this false. Production forces it to true.
AUTH_SESSION_COOKIE_SECURE=false
# lax | strict | none. 'none' requires AUTH_SESSION_COOKIE_SECURE=true.
AUTH_SESSION_COOKIE_SAMESITE=lax
# Optional cookie domain; leave empty for same-host cookies.
AUTH_SESSION_COOKIE_DOMAIN=
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_MAX_LENGTH=128
# Failed sign-in attempts allowed per (email, client IP) before a temporary lockout.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SECONDS=900

# ---------------------------------------------------------------- custom model
# Repository that contains the trained architecture (model.py).
# Must be the aimodel branch of https://github.com/venu-822006/multimodal-ai
MODEL_REPO_PATH=../multimodal-ai

# Absolute path to the trained checkpoint (for example best.pt).
# Leave empty to run the API with model inference reported as unavailable.
MODEL_PATH=

# auto | cpu | cuda
MODEL_DEVICE=auto
MODEL_BATCH_SIZE=1

# Optional overrides; when unset the values stored in the checkpoint are used.
# MODEL_PATCH_SIZE=256
# MODEL_STRIDE=128

MODEL_TEMPERATURE=1.0
MODEL_CONFIDENCE_THRESHOLD=0.5
MODEL_MIN_CLUSTER_PX=0
MODEL_TEMPORAL_FILTER=true
MODEL_REQUIRE_CHECKPOINT=true

# ---------------------------------------------------------------- prediction provider
# What produces the flood prediction mask.
#   trained_model   real FloodSight U-Net weights (requires MODEL_PATH)
#   synthetic_test  deterministic test pattern, labelled synthetic_test_data everywhere
# The synthetic provider is NEVER selected automatically. It is only used when set
# here, or per analysis request in development/test. Refused in production.
PREDICTION_PROVIDER=trained_model

# Synthetic provider settings (ignored unless PREDICTION_PROVIDER=synthetic_test).
# blocky | blobs | gradient | checkerboard
SYNTHETIC_PATTERN=blocky
SYNTHETIC_SEED=20260921
SYNTHETIC_COVERAGE=0.06
SYNTHETIC_MIN_BLOB_PX=24
SYNTHETIC_APPLY_TEMPORAL_FILTER=false

# ---------------------------------------------------------------- imagery
# Public STAC catalogue that hosts Sentinel-1 RTC and Sentinel-2 L2A.
# Planetary Computer signing is applied to asset URLs automatically, so no
# account or API key is required for these open collections.
STAC_ENDPOINT=https://planetarycomputer.microsoft.com/api/stac/v1
IMAGERY_MAX_CANDIDATES=40

# ---------------------------------------------------------------- processing
RASTER_TARGET_RESOLUTION_M=20.0
MIN_FLOOD_POLYGON_AREA_M2=5000.0
MAX_BBOX_AREA_KM2=5000.0
MAX_BBOX_DIMENSION_DEG=5.0

# ---------------------------------------------------------------- exposure context
# OpenStreetMap lookups are supporting analysis only and can be disabled.
# Endpoint order matters: overpass-api.de is the most reliable public mirror, so it
# is listed first. Do not replace IMAGERY_USER_AGENT with a browser-like agent:
# several Overpass mirrors answer HTTP 406 to those.
OSM_ENABLED=true
OSM_ENDPOINT=https://overpass-api.de/api/interpreter
OSM_FALLBACK_ENDPOINTS=https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter

# ---------------------------------------------------------------- artifacts
# Generated GeoTIFFs, GeoJSON and reports are written here, never into git.
ARTIFACT_ROOT=./var/artifacts
REPORT_PUBLIC_BASE_URL=

# ---------------------------------------------------------------- worker
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_STALE_AFTER_SECONDS=900
MODEL_REPO_PATH=/opt/multimodal-ai
MODEL_PATH=/opt/multimodal-ai/checkpoints/best.pt
MODEL_DEVICE=cpu
PREDICTION_PROVIDER=trained_model
